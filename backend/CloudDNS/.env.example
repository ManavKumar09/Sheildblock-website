# =========================
# Frontend / CORS
# =========================

FRONTEND_URL=Frontend

CORS_ORIGINS=FRONTEND_URL,Backend


# =========================
# JWT / Auth
# =========================

SECRET_KEY=change_this_to_a_long_random_string
ALGORITHM=HS256


# =========================
# Trial Config
# =========================

TRIAL_DAYS=90


# =========================
# PostgreSQL
# =========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clientInfo
POSTGRES_USER=shieldblock
POSTGRES_PASSWORD=your_password


# =========================
# Valkey
# =========================

VALKEY_HOST=localhost
VALKEY_PORT=6379


# =========================
# Email Configuration
# =========================

MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
